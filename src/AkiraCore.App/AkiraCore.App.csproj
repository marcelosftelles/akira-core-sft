<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Permite compilar fora do Windows (CI em Linux); só executa no Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>AkiraCore</AssemblyName>
    <RootNamespace>AkiraCore.App</RootNamespace>
    <ApplicationIcon>Assets\akira.ico</ApplicationIcon>
    <!-- Metadados exibidos nas propriedades do .exe e no instalador -->
    <Version>1.0.0</Version>
    <Product>AkiraCore</Product>
    <AssemblyTitle>AkiraCore</AssemblyTitle>
    <Description>Controle de iluminação do teclado AKIRA CORE</Description>
    <Company>AkiraCore</Company>
    <Copyright>Projeto AkiraCore, 2026</Copyright>
    <!-- Versão limpa nas propriedades do .exe (sem o hash do commit) -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- O WebView2Loader.dll nativo vai dentro do .exe quando publicado como arquivo único -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AkiraCore.Core\AkiraCore.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <ItemGroup>
    <!-- Interface HTML embutida no executável e servida pelo EmbeddedUi -->
    <EmbeddedResource Include="Ui\*.html;Ui\*.css;Ui\*.js" LogicalName="Ui/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\akira.ico" LogicalName="Assets/akira.ico" />
  </ItemGroup>

  <!-- O pacote do WebView2 referencia o controle de WPF em todo app .NET 5+. Este app é só
       WinForms: remover evita o conflito de WindowsBase (MSB3277) e uma DLL inútil na saída. -->
  <Target Name="RemoveWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
